<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <remove value="default.asp" />
        <add value="default.asp" />
      </files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <fileExtensions>
          <remove fileExtension=".sql" />
          <add fileExtension=".sql" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="includes" />
          <add segment="tests" />
          <add segment=".workbuddy-ai" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
